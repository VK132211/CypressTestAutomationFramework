{
  "name": "cypresstestautomationframework",
  "version": "1.0.0",
  "description": "e2e cypresstestautomationframework",
  "main": "index.js",
  "lint-staged": {
    "cypress/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/**/*.ts",
      "cypress/support/step_definitions/**/*.ts"
    ]
  },
  "scripts": {
    "test": "rm -rf allure-results allure-report cypress/screenshots cypress/videos && npm run cy:run && npm run report:generate && npm run report:open",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "prepare": "husky",
    "report:generate": "allure generate allure-results --clean --single-file allure-report",
    "report:open": "allure open allure-report",
    "report:serve": "allure serve allure-results"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^24.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@types/node": "^25.6.2",
    "ajv": "^8.20.0",
    "allure-commandline": "^2.40.0",
    "allure-cypress": "^3.7.2",
    "cypress": "^15.14.2",
    "cypress-plugin-api": "^2.11.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^6.4.1",
    "eslint-plugin-prettier": "^5.5.5",
    "http-status-codes": "^2.3.0",
    "husky": "^9.1.7",
    "json-diff": "^1.0.6",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
